msgstr "Sau đó mở ứng dụng ngân hàng và quét QR chuyển khoản"

#. translators: %s: nội dung chuyển khoản
#: templates/bank-details.php:69
#, php-format
msgid "Please transfer the correct content <b>%s</b> for we can confirm the payment"
msgstr "Vui lòng chuyển đúng nội dung <b>%s</b> để chúng tôi có thể xác nhận thanh toán"

#: classes/class-wc-gateway-vietqr.php:426
#: templates/bank-details.php:84
msgid "Bank"
msgstr "Ngân hàng"

#. Description of the plugin
#: wc-gateway-vietqr.php
msgid "Bank transfer by VietQR code for WooCommerce, accepted by most Vietnamese banking apps and e-wallets: Vietcombank, VietinBank, BIDV, Agribank, Techcombank, MBBank, MoMo, ZaloPay..."
msgstr "Chuyển khoản ngân hàng bằng mã VietQR cho WooCommerce, được hầu hết ứng dụng ngân hàng và ví điện tử Việt Nam hỗ trợ: Vietcombank, VietinBank, BIDV, Agribank, Techcombank, MBBank, MoMo, ZaloPay..."

#: classes/class-wc-gateway-vietqr.php:171
msgid "Enable/Disable"
msgstr "Bật/Tắt"

#: classes/class-wc-gateway-vietqr.php:173
msgid "Enable bank transfer"
msgstr "Bật chuyển khoản ngân hàng"

