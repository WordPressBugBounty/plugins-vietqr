#: classes/class-wc-gateway-vietqr.php:41
msgid "Direct bank transfer (Scan VietQR)"
msgstr "Chuyển khoản ngân hàng (Quét mã VietQR)"

#: classes/class-wc-gateway-vietqr.php:42
msgid "Take payments by scanning QR code with Vietnamese banking App. Supported by most major banks in Vietnam"
msgstr "Thực hiện thanh toán bằng cách quét mã QR bằng App ngân hàng. Hỗ trợ bởi hầu hết các ngân hàng lớn Việt Nam"

#: classes/class-wc-gateway-vietqr.php:200
msgid "Scan the bank transfer code"
msgstr "Chuyển khoản ngân hàng (Quét mã QR)"

#: classes/class-wc-gateway-vietqr.php:207
msgid "Transfer payments using the banking App to scan the code. Supported by almost Vietnamese banking apps"
msgstr "Chuyển khoản thanh toán bằng cách dùng App ngân hàng quét mã QR (VietQR). Tiện lợi và miễn phí. Hầu hết App ngân hàng Việt Nam đã hỗ trợ VietQR"

#: classes/class-wc-gateway-vietqr.php:229
msgid "Prefix"
msgstr "Tiền tố"

#: classes/class-wc-gateway-vietqr.php:231
msgid "Prefix used to combine with order code to create money transfer content, Set rules: no spaces, no more than 15 characters and no special characters. Violations will be deleted"
msgstr "Tiền tố dùng để kết hợp với mã đơn hàng tạo nội dung chuyển tiền, Đặt quy tắc: không dấu cách, không quá 10 ký tự và không ký tự đặc biệt. Vi phạm sẽ bị xóa"

