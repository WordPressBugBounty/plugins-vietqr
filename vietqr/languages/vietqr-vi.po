msgid "Title"
msgstr "Tiêu đề"

#: classes/class-wc-gateway-vietqr.php:179
msgid "This controls the title which the user sees during checkout."
msgstr "Tiêu đề khách hàng nhìn thấy khi thanh toán."

#: classes/class-wc-gateway-vietqr.php:184
msgid "Description"
msgstr "Mô tả"

#: classes/class-wc-gateway-vietqr.php:186
msgid "Payment method description that the customer will see on your checkout."
msgstr "Mô tả phương thức thanh toán khách hàng nhìn thấy khi thanh toán."

#: classes/class-wc-gateway-vietqr.php:191
msgid "Instructions"
msgstr "Hướng dẫn"

#: classes/class-wc-gateway-vietqr.php:193
msgid "Instructions that will be added to the thank you page and emails."
msgstr "Hướng dẫn hiển thị trên trang cảm ơn và trong email."

#: classes/class-wc-gateway-vietqr.php:287
msgid "We will review and send you a gift via MoMo if you are eligible"
msgstr "Chúng tôi sẽ xét duyệt và gửi quà qua MoMo nếu bạn đủ điều kiện"

